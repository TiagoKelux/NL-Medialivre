# Registo da aplicação no Azure (Entra ID).
# A app tem de ter "Allow public client flows" ativo para o device code funcionar.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

DATABASE_PATH=./data/monitor.db
TZ=Europe/Lisbon

# Gmail por IMAP (tem precedência sobre o Graph quando preenchido).
# Palavra-passe de app: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Primeiro dia monitorizado (AAAA-MM-DD). Dias anteriores não geram registos.
MONITOR_INICIO=
