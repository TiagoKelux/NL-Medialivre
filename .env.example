# Registo da aplicação no Azure (Entra ID).
# A app tem de ter "Allow public client flows" ativo para o device code funcionar.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

DATABASE_PATH=./data/monitor.db
TZ=Europe/Lisbon

# Gmail por IMAP (tem precedência sobre o Graph quando preenchido).
# Palavra-passe de app: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Primeiro dia monitorizado (AAAA-MM-DD). Dias anteriores não geram registos.
MONITOR_INICIO=

# Avisos do cliente por email (docs/AVISOS.md, página /avisos).
# Endereços autorizados a mandar avisos à caixa, separados por vírgulas.
# Vazio = ninguém: os emails não são tratados como avisos.
AVISOS_REMETENTES=
# Chave da API da Anthropic para ler os avisos em texto livre e propor pausas.
# Vazio = sem IA: os avisos aparecem em /avisos para tratar à mão.
# A IA só propõe; cada pausa é aplicada por alguém no painel.
ANTHROPIC_API_KEY=
# Modelo (opcional). Por omissão: claude-opus-5-5.
AVISOS_MODELO=
